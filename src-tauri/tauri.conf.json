{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finance Tracker",
  "version": "0.1.0",
  "identifier": "com.finance.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Finance Tracker",
        "width": 1120,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; script-src 'self' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Local-first personal finance tracker",
    "longDescription": "Private local finance tracker with ledger, budgets, recurring bills, forecasting and what-if scenarios."
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
